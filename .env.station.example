# Camera and YOLO
TQ_MODEL_PATH=paper detection/best.pt
TQ_CAMERA_INDEX=0
TQ_DETECTION_CONFIDENCE=0.63
# Normalized x1,y1,x2,y2; calibrate around only the physical platform.
TQ_PLATFORM_ROI=0.15,0.18,0.85,0.88
TQ_COUNT_STABILITY_SECONDS=1.5
TQ_PLATFORM_EMPTY_SECONDS=1.2
# Optional JSON mapping from exact model labels to Paper or Plastic. Tin cans use the inductive sensor.
TQ_YOLO_CLASS_MAP={"plastic-bottle":"Plastic"}
TQ_PREVIEW_FPS=20
TQ_JPEG_QUALITY=80

# ESP32 serial and workflow timeouts
TQ_SERIAL_PORT=COM3
TQ_BAUD_RATE=115200
TQ_SORT_TIMEOUT_SECONDS=30
TQ_HTTP_TIMEOUT_SECONDS=8

# Backend and local kiosk bridge
TQ_BACKEND_URL=http://127.0.0.1:5001
TQ_DEVICE_KEY=replace-with-the-bin-device-key-from-the-admin-dashboard
TQ_GATEWAY_PORT=8765

# Set true (or run station_gateway.py --simulate) for no-hardware testing.
TQ_SIMULATION_MODE=false
# Keep false so simulation never sends claims to the real backend.
TQ_SIMULATION_USE_BACKEND=false
