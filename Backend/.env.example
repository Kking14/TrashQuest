MONGO_URI=mongodb://127.0.0.1:27017/trashquest
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=5001
FRONTEND_ORIGINS=

# Password reset email (example: Gmail SMTP with an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-app-password
SMTP_FROM="TrashQuest <your-email@gmail.com>"

# Per-item reward rates
TQ_POINTS_PER_ITEM_PAPER=5
TQ_POINTS_PER_ITEM_PLASTIC=10
TQ_POINTS_PER_ITEM_TIN_CAN=15
